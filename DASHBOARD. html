<script>
  // ========================================
  // SIDEBAR MENU
  // ========================================
  const menuBtn = document.getElementById('menuBtn');
  const sideMenu = document.getElementById('sideMenu');
  const closeBtn = document.getElementById('closeBtn');
  const overlay = document.getElementById('overlay');

  menuBtn?.addEventListener('click', function() {
    sideMenu.classList.add('active');
    overlay.classList.add('active');
  });

  function closeSideMenu() {
    sideMenu?.classList.remove('active');
    overlay?.classList.remove('active');
  }

  closeBtn?.addEventListener('click', closeSideMenu);
  overlay?.addEventListener('click', closeSideMenu);


  // ========================================
  // SEARCH AND FILTERS
  // ========================================
  const searchForm = document.querySelector('.searchbar');
  const searchInput = document.querySelector('.searchbar input');
  const statusChips = document.querySelectorAll('.status-chip');
  const categoryChips = document.querySelectorAll('.filter-chip');

  let activeStatus = 'All';
  let activeCategory = 'All Categories';

  function filterItems() {
    const query = (searchInput?.value || '').trim().toLowerCase();

    document.querySelectorAll('.item-card').forEach(card => {
      const name =
        card.querySelector('.itemName')?.textContent.toLowerCase() || '';

      const category =
        card.querySelector('.categories')?.textContent.trim().toLowerCase() || '';

      const location =
        card.querySelector('.loc-text')?.textContent.toLowerCase() || '';

      const status =
        card.querySelector('.item-status')?.textContent.trim().toLowerCase() || '';

      const matchesQuery =
        !query || `${name} ${category} ${location} ${status}`.includes(query);

      const matchesStatus =
        activeStatus === 'All' || status === activeStatus.toLowerCase();

      const matchesCategory =
        activeCategory === 'All Categories' ||
        category === activeCategory.toLowerCase();

      card.hidden = !(matchesQuery && matchesStatus && matchesCategory);
    });
  }

  statusChips.forEach(chip => {
    chip.addEventListener('click', () => {
      activeStatus = chip.textContent.trim();

      statusChips.forEach(item => {
        item.classList.toggle('active', item === chip);
      });

      filterItems();
    });
  });

  categoryChips.forEach(chip => {
    chip.addEventListener('click', () => {
      activeCategory = chip.textContent.trim();

      categoryChips.forEach(item => {
        item.classList.toggle('active', item === chip);
      });

      filterItems();
    });
  });

  searchInput?.addEventListener('input', filterItems);

  searchForm?.addEventListener('submit', event => {
    event.preventDefault();
    filterItems();

    document.querySelector('.items-section')?.scrollIntoView({
      behavior: 'smooth',
      block: 'start'
    });
  });


  // ========================================
  // MODAL ELEMENTS
  // ========================================
  const itemsContainer = document.querySelector('.items-placeholder');

  const itemModal = document.getElementById('itemModal');
  const claimModal = document.getElementById('claimModal');
  const reportModal = document.getElementById('reportModal');

  const closeModalBtn = document.getElementById('closeModalBtn');
  const closeClaimModalBtn = document.getElementById('closeClaimModalBtn');
  const cancelClaimBtn = document.getElementById('cancelClaimBtn');
  const closeReportModalBtn = document.getElementById('closeReportModalBtn');

  const modalImage = document.getElementById('modalItemImage');
  const modalName = document.getElementById('modalItemName');
  const modalCategory = document.getElementById('modalItemCategory');
  const modalLocation = document.getElementById('modalItemLocation');
  const modalTime = document.getElementById('modalItemTime');
  const modalBrand = document.getElementById('modalItemBrand');
  const modalDate = document.getElementById('modalItemDate');
  const modalStatus = document.getElementById('modalItemStatus');
  const modalDescription = document.getElementById('modalItemDescription');

  const openClaimModalBtn = document.getElementById('openClaimModalBtn');

  function closeAllModals() {
    itemModal?.classList.remove('active');
    claimModal?.classList.remove('active');
    reportModal?.classList.remove('active');
  }

  function openModal(modalId) {
    closeAllModals();

    const modal = document.getElementById(modalId);

    if (modal) {
      modal.classList.add('active');
    }
  }


  // ========================================
  // ITEM DETAILS MODAL
  // ========================================
  function openCardDetails(card) {
    const cardImage = card.querySelector('.item-image img');
    const cardName = card.querySelector('.itemName');
    const cardCategory = card.querySelector('.categories');
    const cardLocation = card.querySelector('.loc-text');
    const cardTime = card.querySelector('.item-time');
    const cardStatus = card.querySelector('.item-status');

    if (!cardName || !cardStatus) return;

    modalImage.src = cardImage?.src || '';
    modalImage.alt = cardImage?.alt || cardName.textContent;

    modalName.textContent = cardName.textContent;
    modalCategory.textContent = cardCategory?.textContent || 'Not specified';
    modalLocation.textContent = cardLocation?.textContent || 'Not specified';
    modalTime.textContent = cardTime?.textContent || 'Not specified';

    modalBrand.textContent = card.dataset.brand || 'Not specified';
    modalDate.textContent = card.dataset.itemDate || 'Not specified';

    modalDescription.textContent =
      card.dataset.description || 'No description available.';
// Determine status: prioritize the card's saved status
const itemStatus = (
  card.dataset.status ||
  (cardStatus.classList.contains('status-lost')
    ? 'Lost'
    : cardStatus.classList.contains('status-found')
      ? 'Found'
      : cardStatus.textContent.trim())
).toLowerCase();

const isLost = itemStatus === 'lost';
const isFound = itemStatus === 'found';
    
    modalStatus.textContent = isLost ? 'Lost' : (isFound ? 'Found' : cardStatus.textContent.trim());

    modalStatus.className = 'item-status';

    if (isLost) {
      modalStatus.classList.add('status-lost');
    } else {
      modalStatus.classList.add('status-found');
    }

    // Only found items can be claimed
    if (isFound) {
      openClaimModalBtn.hidden = false;
      openClaimModalBtn.textContent = 'Claim Item';
    } else {
      openClaimModalBtn.hidden = true;
    }

    openModal('itemModal');
  }

  itemsContainer?.addEventListener('click', function(e) {
    const card = e.target.closest('.item-card');

    if (card && itemsContainer.contains(card)) {
      openCardDetails(card);
    }
  });

  // Keyboard support for item cards
  itemsContainer?.addEventListener('keydown', function(e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;

    const card = e.target.closest('.item-card');

    if (card && itemsContainer.contains(card)) {
      e.preventDefault();
      openCardDetails(card);
    }
  });

  function closeItemModal() {
    itemModal?.classList.remove('active');
  }

  closeModalBtn?.addEventListener('click', closeItemModal);

  itemModal?.addEventListener('click', function(e) {
    if (e.target === itemModal) {
      closeItemModal();
    }
  });


  // ========================================
// GLOBAL TOAST
// ========================================
const claimToast = document.getElementById('claimToast');
const closeToastBtn = document.getElementById('closeToastBtn');
const toastTitle = document.getElementById('toastTitle');
const toastDescription = document.getElementById('toastDescription');

let toastTimer;

function showToast(title, message) {
  if (!claimToast || !toastTitle || !toastDescription) {
    console.error('Toast elements not found. Check toast HTML IDs.');
    return;
  }

  clearTimeout(toastTimer);

  toastTitle.textContent = title;
  toastDescription.textContent = message;

  claimToast.classList.remove('show');

  // Wait for modal closing/layout to finish, then show toast
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      claimToast.classList.add('show');
    });
  });

  // Automatically hide after 4 seconds
  toastTimer = setTimeout(() => {
    hideToast();
  }, 4000);
}

function hideToast() {
  claimToast?.classList.remove('show');
  clearTimeout(toastTimer);
}

closeToastBtn?.addEventListener('click', hideToast);


  // ========================================
  // CLAIM VERIFICATION MODAL
  // ========================================
  const claimForm = document.getElementById('claimForm');
  const claimItemName = document.getElementById('claimItemName');

  openClaimModalBtn?.addEventListener('click', function() {
    claimItemName.textContent = modalName.textContent;
    openModal('claimModal');
  });

  function closeClaimModal() {
    claimModal?.classList.remove('active');
  }

  closeClaimModalBtn?.addEventListener('click', closeClaimModal);
  cancelClaimBtn?.addEventListener('click', closeClaimModal);

  claimModal?.addEventListener('click', function(e) {
    if (e.target === claimModal) {
      closeClaimModal();
    }
  });

  claimForm?.addEventListener('submit', function(e) {
    e.preventDefault();

    closeClaimModal();
    closeItemModal();
    claimForm.reset();

    showToast(
      'Claim request submitted!',
      'Your request is pending review by the campus administrator.'
    );
  });


  // ========================================
  // LOST / FOUND REPORT MODAL
  // ========================================
  const lostBtn = document.getElementById('lostBtn');
  const foundBtn = document.getElementById('foundBtn');

  const reportModalTitle = document.getElementById('reportModalTitle');
  const reportForm = document.getElementById('reportForm');

  let reportStatus = 'Lost';

  const reportItemName = document.getElementById('reportItemName');
  const reportCategory = document.getElementById('reportCategory');
  const customCategoryGroup = document.getElementById('customCategoryGroup');
  const customCategory = document.getElementById('customCategory');
  const reportLocation = document.getElementById('reportLocation');
  const reportPhoto = document.getElementById('reportPhoto');
  const reportDescription = document.getElementById('reportDescription');

  reportCategory?.addEventListener('change', function() {
    const isOthers = reportCategory.value === 'Others';

    customCategoryGroup.hidden = !isOthers;
    customCategory.required = isOthers;

    if (!isOthers) {
      customCategory.value = '';
    }
  });

  function openReportModal(status) {
    reportStatus = status;

    reportModalTitle.textContent =
      status === 'Lost' ? 'Report Lost Item' : 'Report Found Item';

    openModal('reportModal');
  }

  lostBtn?.addEventListener('click', function() {
    openReportModal('Lost');
  });

  foundBtn?.addEventListener('click', function() {
    openReportModal('Found');
  });

  function closeReportModal() {
    reportModal?.classList.remove('active');
  }

  closeReportModalBtn?.addEventListener('click', closeReportModal);

  reportModal?.addEventListener('click', function(e) {
    if (e.target === reportModal) {
      closeReportModal();
    }
  });


  // ========================================
  // SUBMIT LOST / FOUND REPORT
  // ========================================
  reportForm?.addEventListener('submit', function(e) {
    e.preventDefault();

    const name = reportItemName.value.trim();

    const category =
      reportCategory.value === 'Others'
        ? customCategory.value.trim()
        : reportCategory.value;

    const location = reportLocation.value.trim();
    const description = reportDescription.value.trim();
    const photo = reportPhoto.files[0];

    const brand = document.getElementById('reportBrand').value.trim();
const itemDate = document.getElementById('reportItemDate').value;

// AUTOMATIC REPORTER INFORMATION
const reporterName =
  localStorage.getItem('iFoundUserName') || '';

const reporterIdentifier =
  localStorage.getItem('iFoundIdentifier') || '';

  if (!reporterName || !reporterIdentifier) {
  alert('Unable to identify your account. Please log in again.');
  return;
}

    if (!name || !category || !location || !description || !photo || !itemDate) {
      alert('Please complete all fields and upload an item photo.');
      return;
    }

    if (!photo.type.startsWith('image/')) {
      alert('Please select a valid image file.');
      return;
    }

    // Create new item card
    const card = document.createElement('div');

    card.className = 'item-card';
    card.tabIndex = 0;
    card.setAttribute('role', 'button');
    card.setAttribute('aria-label', 'View details for ' + name);

    card.dataset.description = description;
card.dataset.brand = brand;
card.dataset.itemDate = itemDate;
card.dataset.status = reportStatus;

// REPORTER INFORMATION
card.dataset.reporterName = reporterName;
card.dataset.reporterIdentifier = reporterIdentifier;
card.dataset.reporterType = 'PLMun User';

    card.innerHTML = `
      <div class="item-image">
        <img alt="">
        <span class="item-status"></span>
      </div>

      <div class="item-info">
        <p class="categories"></p>
        <h2 class="itemName"></h2>

        <p class="loc">
          <img src="pin.png" alt="">
          <span class="loc-text"></span>
        </p>

        <div class="item-time-wrapper">
          <img src="time.png" alt="">
          <p class="item-time"></p>
        </div>
      </div>
    `;

    const cardImage = card.querySelector('.item-image img');

    cardImage.src = URL.createObjectURL(photo);
    cardImage.alt = name;

    // Correct Lost / Found status
    const statusLabel = card.querySelector('.item-status');

    statusLabel.textContent = reportStatus;
    statusLabel.classList.add(
      reportStatus === 'Lost' ? 'status-lost' : 'status-found'
    );

    card.querySelector('.categories').textContent = category;
    card.querySelector('.itemName').textContent = name;
    card.querySelector('.loc-text').textContent = location;

    const now = new Date();

    const time = now.toLocaleTimeString('en-US', {
      hour: 'numeric',
      minute: '2-digit'
    });

    card.querySelector('.item-time').textContent = 'Reported at ' + time;

    // Add new card to the top
    itemsContainer.prepend(card);

    // Reset filters to show the new report
    activeStatus = 'All';
    activeCategory = 'All Categories';

    if (searchInput) {
      searchInput.value = '';
    }

    statusChips.forEach(chip => {
      chip.classList.toggle(
        'active',
        chip.textContent.trim() === activeStatus
      );
    });

    categoryChips.forEach(chip => {
      chip.classList.toggle(
        'active',
        chip.textContent.trim() === activeCategory
      );
    });

    filterItems();

    // Reset form
    reportForm.reset();

    customCategoryGroup.hidden = true;
    customCategory.required = false;

    closeReportModal();

showToast(
  reportStatus === 'Lost'
    ? 'Lost item report submitted!'
    : 'Found item report submitted!',
  'Your item report has been successfully added to the dashboard.'
);

  });


  // ========================================
  // ESCAPE KEY - CLOSE MODALS
  // ========================================
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeAllModals();
      hideToast();
      closeSideMenu();
    }
  });


  // ========================================
  // NOTIFICATION AND USER DROPDOWNS
  // ========================================
  const notifBtn = document.getElementById('notifBtn');
  const notifDropdown = document.getElementById('notifDropdown');

  const signInBtn = document.getElementById('signInBtn');
  const userDropdown = document.getElementById('userDropdown');

  notifBtn?.addEventListener('click', function(e) {
    e.stopPropagation();

    notifDropdown.classList.toggle('active');
    userDropdown.classList.remove('active');
  });

  signInBtn?.addEventListener('click', function(e) {
    e.stopPropagation();

    userDropdown.classList.toggle('active');
    notifDropdown.classList.remove('active');
  });

  document.addEventListener('click', function() {
    notifDropdown?.classList.remove('active');
    userDropdown?.classList.remove('active');
  });


  // ========================================
  // USER PROFILE INFO
  // ========================================
  const savedUserName = localStorage.getItem('iFoundUserName') || 'Ruffa';
  const savedIdentifier = localStorage.getItem('iFoundIdentifier');

  const signInSpan = document.querySelector('.sign-in span');

  if (signInSpan) {
    signInSpan.textContent = savedUserName;
  }

  const userNameDropdown = document.querySelector('.user-name');
  const userEmailDropdown = document.querySelector('.user-email');

  if (userNameDropdown) {
    userNameDropdown.textContent = savedUserName;
  }

  if (userEmailDropdown && savedIdentifier) {
    userEmailDropdown.textContent = savedIdentifier;
  }

</script>

</body>
</html>
