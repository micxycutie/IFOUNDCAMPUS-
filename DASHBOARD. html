<script>
  // Sidebar Menu Logic
  const menuBtn = document.getElementById('menuBtn');
  const sideMenu = document.getElementById('sideMenu');
  const closeBtn = document.getElementById('closeBtn');
  const overlay = document.getElementById('overlay');

  menuBtn.addEventListener('click', function() {
    sideMenu.classList.add('active');
    overlay.classList.add('active');
  });

  function closeSideMenu() {
    sideMenu.classList.remove('active');
    overlay.classList.remove('active');
  }
  closeBtn.addEventListener('click', closeSideMenu);
  overlay.addEventListener('click', closeSideMenu);

  
  const searchForm = document.querySelector('.searchbar');
  const searchInput = document.querySelector('.searchbar input');
  const statusChips = document.querySelectorAll('.status-chip');
  const categoryChips = document.querySelectorAll('.filter-chip');
  let activeStatus = 'All';
  let activeCategory = 'All Categories';

  function filterItems() {
    const query = (searchInput?.value || '').trim().toLowerCase();
    document.querySelectorAll('.item-card').forEach(card => {
      const name = card.querySelector('.itemName')?.textContent.toLowerCase() || '';
      const category = card.querySelector('.categories')?.textContent.trim().toLowerCase() || '';
      const location = card.querySelector('.loc-text')?.textContent.toLowerCase() || '';
      const status = card.querySelector('.item-status')?.textContent.trim().toLowerCase() || '';
      const matchesQuery = !query || `${name} ${category} ${location} ${status}`.includes(query);
      const matchesStatus = activeStatus === 'All' || status === activeStatus.toLowerCase();
      const matchesCategory = activeCategory === 'All Categories' || category === activeCategory.toLowerCase();
      card.hidden = !(matchesQuery && matchesStatus && matchesCategory);
    });
  }

  statusChips.forEach(chip => chip.addEventListener('click', () => {
    activeStatus = chip.textContent.trim();
    statusChips.forEach(item => item.classList.toggle('active', item === chip));
    filterItems();
  }));

  categoryChips.forEach(chip => chip.addEventListener('click', () => {
    activeCategory = chip.textContent.trim();
    categoryChips.forEach(item => item.classList.toggle('active', item === chip));
    filterItems();
  }));

  searchInput?.addEventListener('input', filterItems);
  searchForm?.addEventListener('submit', event => {
    event.preventDefault();
    filterItems();
    document.querySelector('.items-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });


const itemsContainer = document.querySelector('.items-placeholder');
const itemModal = document.getElementById('itemModal');
const closeModalBtn = document.getElementById('closeModalBtn');
const modalImage = document.getElementById('modalItemImage');
const modalName = document.getElementById('modalItemName');
const modalCategory = document.getElementById('modalItemCategory');
const modalLocation = document.getElementById('modalItemLocation');
const modalTime = document.getElementById('modalItemTime');
const modalStatus = document.getElementById('modalItemStatus');
const modalDescription = document.getElementById('modalItemDescription');
const openClaimModalBtn = document.getElementById('openClaimModalBtn');

function openCardDetails(card) {
  const cardImage = card.querySelector('.item-image img');
  const cardName = card.querySelector('.itemName');
  const cardCategory = card.querySelector('.categories');
  const cardLocation = card.querySelector('.loc-text');
  const cardTime = card.querySelector('.item-time');
  const cardStatus = card.querySelector('.item-status');

  modalImage.src = cardImage.src;
  modalImage.alt = cardImage.alt;
  modalName.textContent = cardName.textContent;
  modalCategory.textContent = cardCategory.textContent;
  modalLocation.textContent = cardLocation ? cardLocation.textContent : 'Not specified';
  modalTime.textContent = cardTime ? cardTime.textContent : 'Not specified';

  modalStatus.textContent = cardStatus.textContent;
  modalStatus.className = 'item-status ' +
    (cardStatus.classList.contains('status-lost') ? 'status-lost' : 'status-found');

  modalDescription.textContent = card.dataset.description || 'No description available.';

  const isFoundItem = cardStatus.classList.contains('status-found');

  if (isFoundItem) {
    openClaimModalBtn.hidden = false;
    openClaimModalBtn.textContent = 'Claim Item';
  } else {
    openClaimModalBtn.hidden = true;
  }

  itemModal.classList.add('active');
}

  itemsContainer.addEventListener('click', function(e) {
  const card = e.target.closest('.item-card');

  if (card && itemsContainer.contains(card)) {
    openCardDetails(card);
  }
});

