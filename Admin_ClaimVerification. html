          <button type="button" class="custom-select-trigger" aria-expanded="false" aria-label="Filter by claim status">
            <span class="selected-text">All Status</span>
            <span class="dropdown-arrow">▼</span>
          </button>
          <ul class="custom-options">
            <li class="custom-option selected" data-value="all">All Status</li>
            <li class="custom-option" data-value="pending">Pending</li>
            <li class="custom-option" data-value="approved">Approved</li>
            <li class="custom-option" data-value="rejected">Rejected</li>
            <li class="custom-option" data-value="claimed">Claimed</li>
          </ul>
        </div>
      </div>

      <button type="button" class="claim-toolbar-btn" id="exportPdfBtn">Export PDF</button>
      <button type="button" class="claim-toolbar-btn" id="exportExcelBtn">Export Excel</button>
