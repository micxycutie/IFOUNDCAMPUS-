/* ==========================================
   MAIN CONTENT AREA 
========================================== */

.admin-main {
  margin-left: 260px; 
  padding-top: 80px;  
  min-height: 100vh;
  background: #F8FAFA; 
  box-sizing: border-box;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
}

.dashboard-content {
  padding: 40px 50px;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  margin-right: 0 auto;
}

.dashboard-content h1 {
  font-size: 28px;
  font-weight: 700;
  color: #18453B; 
  margin: 0 0 6px 0;
  letter-spacing: -0.5px; 
}

.dashboard-content p {
  font-size: 14px;
  font-weight: 400;
  color: #66706B;
  margin: 0;
  line-height: 1.5;
  
}

/* =========================
   DASHBOARD STATISTICS
========================= */

.dashboard-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 22px;
  width: 100%;
  margin-top: 30px;
  margin-right: 0 auto ;
}

/* STAT CARD */
.stat-card {
  min-width: 0;
  min-height: 150px;
  background: #FFFFFF;
  border: 1px solid #E8ECE9;
  border-radius: 12px;
  padding: 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-shadow: 0 2px 8px rgba(24, 69, 59, 0.04);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  box-sizing: border-box; /* Tinitiyak na hindi lalamang ang padding sa sukat */
}

.stat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 5px 15px rgba(24, 69, 59, 0.08);
}

/* STAT INFORMATION */
.stat-info {
  display: flex;
  flex-direction: column;
  gap: 7px;
  min-width: 0;
  font-family: inherit; 
}

.stat-label {
  font-size: 13px;
  font-weight: 600;
  color: #6B756F;
  margin: 0; 
}

.stat-number {
  font-size: 30px;
  font-weight: 700;
  color: #18453B;
  line-height: 1.2;
  margin: 0; 
}

.stat-description {
  font-size: 11px;
  color: #929A95;
  margin: 0;
  overflow-wrap: break-word; 
}

/* ICON CONTAINER */
.stat-icon {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #EAF2ED;
  border-radius: 10px;
}

.stat-icon img {
  width: 25px;
  height: 25px;
  object-fit: contain;
}

/* =========================
   DASHBOARD CHARTS
========================= */

.dashboard-charts {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
  gap: 24px;
  width: 100%;
  margin-top: 30px;
  align-items: stretch;
}

/* CHART CARDS */

.chart-card {
  min-width: 0;
  min-height: 450px;
  background: #FFFFFF;
  border: 1px solid #E8ECE9;
  border-radius: 12px;
  padding: 26px;
  box-shadow: 0 2px 8px rgba(24, 69, 59, 0.04);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* BAR CHART */

.bar-chart {
  display: flex;
  width: 100%;
  height: 320px;
  gap: 16px;
  margin-top: auto;
}

.chart-y-labels {
  width: 30px;
  height: 280px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  flex-shrink: 0;
}

.chart-plot {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 320px;
}

.chart-grid-lines {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  pointer-events: none;
  z-index: 1;
}

.chart-grid-lines span {
  width: 100%;
  border-top: 1px solid #EDF1EE;
}

.chart-bars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280px;
  display: flex;
  justify-content: space-around;
  gap: 12px;
  z-index: 2;
}

.bar-group {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bar-pair {
  width: 100%;
  height: 280px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 6px;
}

.bar {
  width: 28px;
  max-width: 40%;
  flex-shrink: 0;
  border-radius: 5px 5px 0 0;
}

.lost-bar {
  background: #18453B;
}

.found-bar {
  background: #A8D5B5;
}

.month-label {
  margin-top: 8px;
  font-size: 12px;
  color: #66706B;
}

/* CHART LEGEND */

.chart-legend {
  display: flex;
  gap: 20px;
  margin-top: 20px;
  font-size: 12px;
  color: #66706B;
}

.chart-legend span {
  display: flex;
  align-items: center;
  gap: 7px;
}

.legend-dot {
  width: 9px;
  height: 9px;
  display: inline-block;
  border-radius: 50%;
}

.lost-dot {
  background: #18453B;
}

.found-dot {
  background: #A8D5B5;
}

/* PIE CHART */

.pie-chart-container {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 25px;
  margin-top: 15px;
}

.pie-chart-visual {
  width: 210px;
  height: 210px;
  flex-shrink: 0;
  border-radius: 50%;
  background: conic-gradient(
    #18453B 0% 50%,
    #A8D5B5 50% 85%,
    #E28743 85% 100%
  );
  box-shadow: inset 0 0 0 24px #FFFFFF;
}

.pie-chart-legend {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  padding-left: 10px;
  box-sizing: border-box;
}

.pie-legend-item {
  display: flex;
  align-items: center;
  gap: 9px;
}

.pie-label {
  font-size: 12px;
  color: #66706B;
}


/* =====================
   DASHBOARD ANALYTICS 
======================== */

.dashboard-analytics {
  display: grid;
  grid-template-columns: 1.5fr 2fr;
  gap: 22px;
  width: 100%;
  margin-top: 24px;
  align-items: stretch;
}


.analytics-card {
  background: #ffffff;
  border: 1px solid #e5eae7;
  border-radius: 14px;
  padding: 26px;
  min-width: 0;
  box-shadow: 0 2px 8px rgba(24, 69, 59, 0.04);
  display: flex;
  flex-direction: column;
}

.top-locations-card, 
.claim-rate-card {
  min-height: 380px; 
}

.analytics-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 24px;
  flex-shrink: 0;
}

.analytics-header h3 {
  font-size: 17px;
  font-weight: 700;
  color: #18453B;
  margin: 0 0 6px 0;
}

.analytics-header p {
  font-size: 12px;
  color: #858D89;
  line-height: 1.5;
  margin: 0;
}

.analytics-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  border-radius: 10px;
  background: #edf5f0;
  color: #18453B;
  font-size: 21px;
}

/* =================
   CLAIM RATE SIDE
==================== */
.claim-rate-summary {
  padding: 20px;
  background: #f4f8f5;
  border-radius: 12px;
  margin-bottom: 20px;
  flex-shrink: 0;
}

.claim-rate-summary h2 {
  color: #18453B;
  font-size: 34px;
  font-weight: 700;
  margin: 0 0 5px 0;
}

.claim-rate-summary p {
  color: #78847D;
  font-size: 12px;
  margin: 0;
}

.claim-status-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-top: auto; 
}

.claim-status-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: #505B55;
}

.claim-status-item strong {
  margin-left: auto;
  color: #18453B;
  font-size: 14px;
}

.status-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  flex-shrink: 0;
}

.approved-dot { background: #2e9d68; }
.pending-dot  { background: #e6a23c; }
.rejected-dot { background: #d95c5c; }

/* ====================
   TOP LOCATIONS SIDE 
======================= */
.top-locations-list {
  display: flex;
  flex-direction: column;
  justify-content: space-between; 
  flex: 1; 
}

.location-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 4px; 
  border-bottom: 1px solid #edf0ee;
  min-width: 0;
}

.location-item:last-child {
  border-bottom: none;
}

.location-rank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  background: #edf5f0;
  color: #18453B;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 700;
}

.location-name {
  color: #505B55;
  font-size: 14px;
  flex: 1;
  min-width: 0;
}

.location-item strong {
  color: #18453B;
  font-size: 15px;
  flex-shrink: 0;
}



/* ==========================================================================
8. RESPONSIVE MEDIA QUERIES
========================================================================== */
@media (max-width: 1100px) {

  .dashboard-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .admin-main {
    margin-left: 0;
  }
  .dashboard-charts {
    grid-template-columns: 1fr; 
  }
  .dashboard-analytics {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}

@media (max-width: 850px) {
  .dashboard-charts,
  .dashboard-analytics {
    grid-template-columns: 1fr;
    gap: 24px;
  }
    
  .pie-chart-container {
    flex-direction: row;
    justify-content: space-around;
  }
    
  .pie-chart-legend {
    width: auto;
  }
}

@media (max-width: 600px) {
  .dashboard-stats {
    grid-template-columns: 1fr;
  }
    
  .pie-chart-container {
    flex-direction: column;
  }
    
  .admin-search input {
    width: 160px;
  }

  .dashboard-content {
    padding: 20px 16px;
  }
  
  .chart-card {
    padding: 16px;
    min-height: 350px;
  }

  .bar-chart {
    height: 220px;
    gap: 6px;
  }

  .chart-plot {
    height: 220px;
  }

  .chart-grid-lines,
  .bar-pair,
  .chart-y-labels {
    height: 192px;
  }

  .bar {
    width: 16px; 
    max-width: 25%;
  }
}

.sidebar-close {
  display: none;
}


@media (max-width: 600px) {

.dashboard-stats {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.stat-card {
  min-height: 125px;
  padding: 14px 12px;
  gap: 8px;
}

.stat-number {
  font-size: 25px;
}

.stat-label {
  font-size: 11px;
}

.stat-description {
  font-size: 10px;
}

.stat-icon {
  width: 36px;
  height: 36px;
}

.stat-icon img {
  width: 20px;
  height: 20px;
}

.dashboard-content {
   padding: 20px 14px;
  }


  /* CHART CARD */
  .chart-card {
    padding: 18px 14px;
    min-height: 360px;
    overflow: hidden;
  }

  /* CHART HEADER */
  .chart-header {
    width: 100%;
    min-width: 0;
    margin-bottom: 12px;
  }

  .chart-header h3 {
    font-size: 15px;
    line-height: 1.4;
  }

  .chart-header p {
    font-size: 11px;
    line-height: 1.4;
  }

  /* LEGEND */
  .chart-legend {
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 5px;
    margin-bottom: 8px;
    font-size: 10px;
  }

  .chart-legend span {
    gap: 5px;
    white-space: nowrap;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
  }

  /* BAR CHART */
  .bar-chart {
    width: 100%;
    height: 230px;
    display: flex;
    gap: 7px;
    margin-top: 15px;
  }

  .chart-y-labels {
    width: 23px;
    height: 185px;
    flex-shrink: 0;
    font-size: 10px;
  }

  .chart-plot {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 230px;
  }

  .chart-grid-lines {
    top: 0;
    height: 185px;
  }

  .chart-bars {
    top: 0;
    height: 185px;
    gap: 3px;
    justify-content: space-around;
  }

  .bar-group {
    flex: 1;
    min-width: 0;
    height: 100%;
  }

  .bar-pair {
    width: 100%;
    height: 185px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 3px;
  }

  .bar {
    width: 12px;
    max-width: 42%;
    min-width: 0;
    flex-shrink: 1;
    border-radius: 3px 3px 0 0;
  }
}
