<script>
  document.addEventListener("DOMContentLoaded", function() {
    // 1. KUHANIN ANG MGA LIVE DATA MULA SA STAT CARDS (HTML IDs)
    const lostCount = parseInt(document.getElementById('num-lost').innerText) || 0;
    const foundCount = parseInt(document.getElementById('num-found').innerText) || 0;
    const pendingCount = parseInt(document.getElementById('num-pending').innerText) || 0;
    const approvedCount = parseInt(document.getElementById('num-matches').innerText) || 0;

    // 2. AUTOMATION PARA SA BAR CHART (Kasalukuyang Buwan - Jun)
    const maxChartValue = 40; // Max value ng Y-Axis mo
    const lostPercentage = Math.min((lostCount / maxChartValue) * 100, 100);
    const foundPercentage = Math.min((foundCount / maxChartValue) * 100, 100);

    const latestBarGroup = document.querySelector('.chart-bars .bar-group:last-child');
    if (latestBarGroup) {
      const lostBar = latestBarGroup.querySelector('.lost-bar');
      const foundBar = latestBarGroup.querySelector('.found-bar');
      if (lostBar) lostBar.style.height = lostPercentage + '%';
      if (foundBar) foundBar.style.height = foundPercentage + '%';
    }

    // 3. AUTOMATION PARA SA CLAIM RATE CARD (Kalkulasyon ng Matagumpay na Claims)
    // Mag-assume tayo ng kaunting rejected claims (halimbawa: 4) para makumpleto ang data
    const rejectedCount = 4; 
    const totalClaims = approvedCount + pendingCount + rejectedCount;

    if (totalClaims > 0) {
      // Compute ng Successful Claim Rate (Approved / Total)
      const successRate = Math.round((approvedCount / totalClaims) * 100);
      
      // I-inject ang mga kalkulado at totoong numero sa Claim Rate UI Card
      document.getElementById('claimRate').innerText = successRate + '%';
      document.getElementById('approvedClaims').innerText = approvedCount;
      document.getElementById('pendingClaims').innerText = pendingCount;
      document.getElementById('rejectedClaims').innerText = rejectedCount;

      // 4. AUTOMATION PARA SA PIE CHART VISUAL (Conic Gradient Base sa live data)
      const approvedPercent = Math.round((approvedCount / totalClaims) * 100);
      const pendingPercent = Math.round((pendingCount / totalClaims) * 100);
      
      const slice1 = approvedPercent;
      const slice2 = approvedPercent + pendingPercent;

      const pieVisual = document.querySelector('.pie-chart-visual');
      if (pieVisual) {
        pieVisual.style.background = `conic-gradient(
          #18453B 0% ${slice1}%,
          #A8D5B5 ${slice1}% ${slice2}%,
          #E28743 ${slice2}% 100%
        )`;
      }

      // I-update din ang mga porsyento sa Pie Chart Legends
      const pieLabels = document.querySelectorAll('.pie-chart-legend .pie-label');
      if (pieLabels.length >= 3) {
        pieLabels[0].innerText = `Approved (${approvedPercent}%)`;
        pieLabels[1].innerText = `Pending (${pendingPercent}%)`;
        pieLabels[2].innerText = `Rejected (${100 - slice2}%)`;
      }
    }

    // 5. SAMPLE LIVE RECORDS PARA SA TOP LOCATIONS
    // Sa hinaharap, ito ay magmumula na sa iyong Database array
    const sampleLocations = [
      { name: "University Library", count: 18 },
      { name: "Gymnasium Lobby", count: 12 },
      { name: "Student Center Cafeteria", count: 9 },
      { name: "Engineering Block - Room 302", count: 5 },
      { name: "Main Campus Oval", count: 3 }
    ];

    const locationsContainer = document.getElementById('topLocationsList');
    if (locationsContainer && sampleLocations.length > 0) {
      locationsContainer.innerHTML = ''; // Linisin ang "Waiting for records"
      
      sampleLocations.forEach((loc, index) => {
        const itemHTML = `
          <div class="location-item">
            <span class="location-rank">${index + 1}</span>
            <span class="location-name">${loc.name}</span>
            <strong>${loc.count}</strong>
          </div>
        `;
        locationsContainer.innerHTML += itemHTML;
      });
    }

    // SIDEBAR TOGGLE
const sidebarToggle = document.querySelector('.sidebar-toggle');

if (sidebarToggle) {
  sidebarToggle.addEventListener('click', function() {
    document.body.classList.toggle('sidebar-open');

    const isOpen = document.body.classList.contains('sidebar-open');

    sidebarToggle.setAttribute('aria-expanded', isOpen);
  });
} 

    const sidebarClose = document.querySelector('.sidebar-close');

if (sidebarClose) {
  sidebarClose.addEventListener('click', function() {
    document.body.classList.remove('sidebar-open');

    if (sidebarToggle) {
      sidebarToggle.setAttribute('aria-expanded', 'false');
    }
  });
}

  
// ================================
// HEADER DROPDOWNS
// ================================

const headerDropdowns = document.querySelectorAll('.header-dropdown');

headerDropdowns.forEach(dropdown => {
  const trigger = dropdown.querySelector('button');

  if (!trigger) return;

  trigger.addEventListener('click', function(event) {
    event.stopPropagation();

    const wasOpen = dropdown.classList.contains('open');

    // Close other dropdowns
    headerDropdowns.forEach(item => {
      item.classList.remove('open');

      const btn = item.querySelector('button');
      if (btn) btn.setAttribute('aria-expanded', 'false');
    });

    // Toggle selected dropdown
    if (!wasOpen) {
      dropdown.classList.add('open');
      trigger.setAttribute('aria-expanded', 'true');
    }
  });
});

// Close dropdown when clicking outside
document.addEventListener('click', function(event) {
  if (!event.target.closest('.header-dropdown')) {
    headerDropdowns.forEach(dropdown => {
      dropdown.classList.remove('open');

      const trigger = dropdown.querySelector('button');
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
    });
  }
});

// Close dropdown using Escape
document.addEventListener('keydown', function(event) {
  if (event.key === 'Escape') {
    headerDropdowns.forEach(dropdown => {
      dropdown.classList.remove('open');

      const trigger = dropdown.querySelector('button');
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
    });
  }
});


// ================================
// NOTIFICATION FUNCTION
// ================================

const notificationItems = document.querySelectorAll('.notification-item');
const notificationBadge = document.getElementById('notificationBadge');
const notificationButton = document.querySelector('.notification-btn');
const markAllRead = document.getElementById('markAllRead');
const notificationDescription = document.querySelector('.dropdown-heading p');

function updateNotificationCount() {
  const unreadCount = document.querySelectorAll(
    '.notification-item.unread'
  ).length;

  if (notificationBadge) {
    notificationBadge.textContent = unreadCount;
    notificationBadge.style.display =
      unreadCount > 0 ? 'flex' : 'none';
  }

  if (notificationButton) {
    notificationButton.setAttribute(
      'aria-label',
      unreadCount + ' unread notifications'
    );
  }

  if (notificationDescription) {
    notificationDescription.textContent =
      unreadCount === 0
        ? 'You are all caught up!'
        : 'You have ' + unreadCount + ' unread notifications';
  }
}

// Mark individual notification as read
notificationItems.forEach(item => {
  item.addEventListener('click', function() {
    item.classList.remove('unread');
    updateNotificationCount();
  });
});

// Mark all notifications as read
if (markAllRead) {
  markAllRead.addEventListener('click', function() {
    notificationItems.forEach(item => {
      item.classList.remove('unread');
    });

    updateNotificationCount();
  });
}

updateNotificationCount();


// ================================
// PROFILE MENU FUNCTION
// ================================

const profileActions = document.querySelectorAll(
  '.profile-dropdown-links button'
);

profileActions.forEach(button => {
  button.addEventListener('click', function() {
    alert(button.dataset.message);
  });
});


// ================================
// DASHBOARD SEARCH FUNCTION
// ================================

const searchInput = document.getElementById('adminSearchInput');
const clearSearch = document.getElementById('clearSearch');

function searchDashboard() {
  if (!searchInput) return;

  const query = searchInput.value
    .trim()
    .toLowerCase();

  // Search dashboard cards
  const searchableCards = document.querySelectorAll(
    '.stat-card, .chart-card, .analytics-card'
  );

  searchableCards.forEach(card => {
    const text = card.textContent.toLowerCase();

    card.style.display =
      !query || text.includes(query) ? '' : 'none';
  });

  // Search individual top locations
  const locationItems = document.querySelectorAll('.location-item');

  locationItems.forEach(item => {
    const text = item.textContent.toLowerCase();

    item.style.display =
      !query || text.includes(query) ? '' : 'none';
  });

  // Clear button visibility
  if (clearSearch) {
    clearSearch.hidden = !query;
  }
}

if (searchInput) {
  searchInput.addEventListener('input', searchDashboard);
}

if (clearSearch) {
  clearSearch.addEventListener('click', function() {
    searchInput.value = '';
    searchDashboard();
    searchInput.focus();
  });
}

  });
</script>



